@url = https://localhost:7176
@url2 = https://localhost:5027
@token = {{login.response.body.$.token}}

### Auth
# @name login
POST {{url}}/api/auth/login
Content-Type: application/json

{
  "Email": "email@gmail.com",
  "Password": ""
}

### Registrar usuario
POST {{url}}/api/auth/register
Content-Type: application/json

{
  "NombreUsuario": "UsuaroPrueba",
  "Email": "email@gmail.com",
  "Password": ""
}



### login ml
GET {{url}}/api/mercadolibre/login
Authorization: Bearer {{token}}

### user me
GET {{url}}/api/MercadoLibre/cuenta/161249179
Authorization: Bearer {{token}}



### Categorias
GET {{url}}/api/categorias
Authorization: Bearer {{token}}

### Obtener por id
GET {{url}}/api/categorias/8
Authorization: Bearer {{token}}

### Lista productos
GET {{url}}/api/productos
Authorization: Bearer {{token}}

### Crear Producto 1
POST {{url}}/api/productos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "sku": "PROD-001",
  "nombre": "Teclado Mecánico RGB",
  "descripcion": "Teclado mecánico con iluminación RGB y conexión USB",
  "precio": 49990,
  "categoriaId": 432323,
  "stockInicial": 10
}

